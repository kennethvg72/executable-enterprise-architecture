# Development settings. Copy to .env (which git ignores). Never put production values here.
NODE_ENV=development
HOST=127.0.0.1
PORT=8443
METRICS_PORT=9464
# The application runs as its own least-privileged role; migrations run as the owner (SEC-09).
DATABASE_URL=postgres://my_application_app:dev-only@localhost:5432/my_application
MIGRATION_DATABASE_URL=postgres://app:app@localhost:5432/my_application
TEST_DATABASE_URL=postgres://app:app@localhost:5432/my_application_test
# The development sign-in lets you pick a user and role. Refused unless NODE_ENV=development and HOST is local.
DEV_SIGN_IN=true
TIME_ZONE=America/Chicago
